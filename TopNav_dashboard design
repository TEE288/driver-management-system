<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FleetHQ — Driver Management</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-primary: #ffffff;
      --bg-secondary: #f7f6f3;
      --bg-tertiary: #f0ede8;
      --text-primary: #1a1a18;
      --text-secondary: #6b6a65;
      --border: rgba(0,0,0,0.1);
      --border-md: rgba(0,0,0,0.15);
      --radius-md: 8px;
      --radius-lg: 12px;

      /* amber brand */
      --amber-50: #FAEEDA;
      --amber-100: #FAC775;
      --amber-400: #BA7517;
      --amber-600: #854F0B;
      --amber-800: #633806;

      /* status */
      --green-50: #EAF3DE; --green-800: #27500A; --green-600: #3B6D11;
      --amber-status-50: #FAEEDA; --amber-status-800: #633806;
      --red-50: #FCEBEB; --red-800: #791F1F;
      --blue-50: #E6F1FB; --blue-800: #0C447C;

      /* avatars */
      --av-a-bg: #FAEEDA; --av-a-txt: #633806;
      --av-t-bg: #E1F5EE; --av-t-txt: #085041;
      --av-b-bg: #E6F1FB; --av-b-txt: #0C447C;
      --av-p-bg: #EEEDFE; --av-p-txt: #3C3489;
      --av-g-bg: #EAF3DE; --av-g-txt: #27500A;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg-tertiary);
      color: var(--text-primary);
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
    }

    /* ── TOP NAV ── */
    .topnav {
      background: var(--bg-primary);
      border-bottom: 0.5px solid var(--border);
      padding: 0 24px;
      display: flex;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      padding: 14px 20px 14px 0;
      border-right: 0.5px solid var(--border);
      margin-right: 8px;
      white-space: nowrap;
      letter-spacing: -0.02em;
    }

    .logo span { color: var(--amber-400); }

    .nav-item {
      padding: 15px 14px;
      font-size: 13px;
      color: var(--text-secondary);
      cursor: pointer;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      transition: color 0.15s;
      white-space: nowrap;
      user-select: none;
    }

    .nav-item:hover { color: var(--text-primary); }

    .nav-item.active {
      color: var(--text-primary);
      border-bottom-color: var(--amber-400);
      font-weight: 500;
    }

    .nav-right {
      margin-left: auto;
      display: flex;
      gap: 8px;
      align-items: center;
    }

    /* ── BUTTONS ── */
    .btn {
      padding: 7px 14px;
      border-radius: var(--radius-md);
      font-size: 13px;
      cursor: pointer;
      border: 0.5px solid var(--border-md);
      background: transparent;
      color: var(--text-primary);
      transition: background 0.15s;
    }

    .btn:hover { background: var(--bg-secondary); }

    .btn-primary {
      background: var(--amber-400);
      border-color: var(--amber-600);
      color: white;
      font-weight: 500;
    }

    .btn-primary:hover { background: var(--amber-600); }

    /* ── BODY ── */
    .body { padding: 20px 24px; max-width: 1280px; margin: 0 auto; }

    /* ── SECTIONS ── */
    .section { display: none; }
    .section.active { display: block; }

    /* ── METRIC CARDS ── */
    .metrics {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 16px;
    }

    .metric {
      background: var(--bg-primary);
      border: 0.5px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 14px 16px;
    }

    .metric-label {
      font-size: 11px;
      color: var(--text-secondary);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .metric-val {
      font-size: 26px;
      font-weight: 500;
      color: var(--text-primary);
      line-height: 1;
    }

    .metric-trend { font-size: 11px; margin-top: 6px; }
    .trend-up { color: var(--green-600); }
    .trend-dn { color: #A32D2D; }

    /* ── CARDS ── */
    .card {
      background: var(--bg-primary);
      border: 0.5px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 16px;
    }

    .card-hd {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    /* ── GRID LAYOUTS ── */
    .main-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }

    .bottom-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    /* ── BADGES ── */
    .badge {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 20px;
      font-weight: 500;
      white-space: nowrap;
    }

    .badge-green  { background: var(--green-50);        color: var(--green-800); }
    .badge-amber  { background: var(--amber-status-50); color: var(--amber-status-800); }
    .badge-red    { background: var(--red-50);          color: var(--red-800); }
    .badge-blue   { background: var(--blue-50);         color: var(--blue-800); }

    /* ── AVATARS ── */
    .av {
      width: 30px; height: 30px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 500;
      flex-shrink: 0;
    }

    .av-a { background: var(--av-a-bg); color: var(--av-a-txt); }
    .av-t { background: var(--av-t-bg); color: var(--av-t-txt); }
    .av-b { background: var(--av-b-bg); color: var(--av-b-txt); }
    .av-p { background: var(--av-p-bg); color: var(--av-p-txt); }
    .av-g { background: var(--av-g-bg); color: var(--av-g-txt); }

    /* ── ROWS ── */
    .row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 0.5px solid var(--border);
    }

    .row:last-child { border-bottom: none; }

    .row-info { flex: 1; min-width: 0; }

    .row-name {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .row-sub { font-size: 11px; color: var(--text-secondary); margin-top: 1px; }

    /* ── STATUS DOTS ── */
    .dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .dot-green  { background: #639922; }
    .dot-amber  { background: var(--amber-400); }
    .dot-blue   { background: #378ADD; }
    .dot-gray   { background: #888780; }

    /* ── STARS ── */
    .stars { color: var(--amber-400); font-size: 11px; }

    /* ── PROGRESS BARS ── */
    .pay-bar {
      flex: 1;
      height: 4px;
      border-radius: 4px;
      background: var(--border);
      overflow: hidden;
    }

    .pay-fill {
      height: 100%;
      border-radius: 4px;
      background: var(--amber-400);
    }

    /* ── ACTION BUTTON (small) ── */
    .action-btn {
      padding: 4px 10px;
      border-radius: var(--radius-md);
      border: 0.5px solid var(--border-md);
      background: transparent;
      font-size: 11px;
      cursor: pointer;
      color: var(--text-secondary);
      transition: all 0.15s;
    }

    .action-btn:hover { background: var(--bg-secondary); color: var(--text-primary); }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      .main-grid   { grid-template-columns: 1fr; }
      .bottom-grid { grid-template-columns: 1fr; }
      .metrics     { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 600px) {
      .metrics { grid-template-columns: 1fr 1fr; }
      .topnav  { padding: 0 12px; overflow-x: auto; }
      .body    { padding: 12px; }
      .logo    { font-size: 13px; padding-right: 12px; margin-right: 4px; }
    }
  </style>
</head>
